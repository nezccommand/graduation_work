<div class="mb-8 text-center text-3xl font-extrabold text-green-900 bg-green-100 border border-green-300 rounded-lg py-4 shadow-md">
  <% if total_count == correct_count && total_count > 0 %>
    <span>全問正解しました！おめでとうございます！</span>
  <% else %>
    <span><%= total_count %>問中</span>
    <span class="text-green-700"><%= correct_count %>問</span>
    <span>正解しました！</span>
  <% end %>
</div>

<% if current_user && total_count == correct_count && @difficulty.present? && @genre.present? %>
  <% badge = Badge.find_by(difficulty: @difficulty, genre: @genre) %>
  <% if badge && current_user.user_badges.exists?(badge: badge, rank: 'gold') %>
    <div class="text-center text-green-800 font-semibold mb-6">
      🎉 バッジ「<%= badge.name %>」が付与されました！
    </div>
  <% end %>
<% end %>

<%= render partial: "result_true_or_false", locals: { result: @result } %>