<div x-data="{ open: false }" class="bg-white border border-green-200 rounded-lg shadow-sm p-6 mb-10">
  <h3 class="text-xl font-semibold mb-3 text-green-800">ユーザー情報</h3>

  <p>
    <strong>ユーザー名：</strong> <%= current_user.name %>
    <button @click="open = true" class="ml-2 text-green-600 underline cursor-pointer">編集</button>
  </p>

  <p><strong>メールアドレス：</strong> <%= current_user.email %></p>

  <div x-show="open"
       x-transition
       class="fixed inset-0 flex items-center justify-center bg-black/30 backdrop-blur-m z-50"
       @click.self="open = false">

    <div class="bg-white rounded-lg shadow-lg p-6 max-w-sm w-full relative
                flex flex-col items-center space-y-6">

      <h2 class="text-lg font-semibold mb-2">ユーザー名を編集</h2>

      <div id="form-errors" class="text-red-500 text-sm w-full"></div>

      <%= form_with(model: current_user, url: registration_path(current_user), method: :put, local: false, id: "edit-name-form") do |f| %>
        <div class="mb-4 w-full">
          <%= f.label :name, "ユーザー名", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :name, 
                class: "outline-none px-1 py-1 mt-1 block w-full rounded-md border-2 border-green-200 focus:border-green-500 focus:ring focus:ring-green-200 focus:ring-opacity-50 shadow-sm transition-colors", 
                value: current_user.name %>
        </div>

        <div class="flex justify-center w-full space-x-2">
          <%= f.submit "更新", class: "px-6 py-2 bg-green-600 text-white rounded-lg cursor-pointer" %>
          <button type="button" @click="open = false" class="px-4 py-2 bg-gray-200 rounded-lg cursor-pointer">キャンセル</button>
        </div>
      <% end %>
    </div>
  </div>
</div>
