<div class="max-w-7xl mx-auto px-4">
  <section class="bg-green-50 py-12 px-4 sm:px-8">
    <div class="max-w-2xl mx-auto text-green-900">
      <h2 class="text-2xl sm:text-3xl font-bold mb-6 text-center border-b border-green-300 pb-4">
        クイズのジャンルと難易度を選んでください
      </h2>

      <%= form_with url: quiz_path(1), method: :get, local: true do %>
        <div class="space-y-8">
          <div>
            <p class="text-lg font-semibold mb-3">ジャンル</p>
            <div class="flex flex-wrap gap-4">
              <% [["基本知識", true], ["対応方法", false]].each_with_index do |(label, checked), i| %>
                <label class="block relative cursor-pointer">
                  <%= radio_button_tag :genre, label, checked, id: "genre_#{i}", class: "peer hidden" %>
                  <div class="bg-white border border-green-300 rounded-lg shadow-sm px-6 py-3 peer-checked:bg-green-100 transition text-green-900 font-semibold">
                    <%= label %>
                  </div>
                </label>
              <% end %>
            </div>
          </div>

          <div>
            <p class="text-lg font-semibold mb-3">難易度</p>
            <div class="flex flex-wrap gap-4">
              <% [["Easy", "easy", true], ["Hard", "hard", false]].each_with_index do |(label, value, checked), i| %>
                <label class="block relative cursor-pointer">
                  <%= radio_button_tag :difficulty, value, checked, id: "difficulty_#{i}", class: "peer hidden" %>
                  <div class="bg-white border border-green-300 rounded-lg shadow-sm px-6 py-3 peer-checked:bg-green-100 transition text-green-900 font-semibold">
                    <%= label %>
                  </div>
                </label>
              <% end %>
            </div>
          </div>
        </div>

        <%= hidden_field_tag :quiz_start, true %>

        <div class="mt-10 flex justify-center">
          <%= submit_tag "クイズスタート", class: "active:scale-95 bg-green-700 text-white px-8 py-4 rounded-lg shadow hover:bg-green-600 transition text-lg font-semibold w-full max-w-xs text-center" %>
        </div>
      <% end %>

    </div>
  </section>
</div>