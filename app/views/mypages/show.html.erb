

<div class="max-w-7xl mx-auto px-4">
  <section class="bg-green-50 py-12 px-4 sm:px-8">
    <div class="max-w-4xl mx-auto text-green-900">
      <h2 class="text-2xl sm:text-3xl font-bold mb-6 text-center border-b border-green-300 pb-4">
        マイページ
      </h2>

      <div class="bg-white border border-green-200 rounded-lg shadow-sm p-6 mb-10">
        <h3 class="text-xl font-semibold mb-3 text-green-800">ユーザー情報</h3>
        <p><strong>ユーザー名：</strong><%= current_user.name || "未設定" %></p>
        <p><strong>メールアドレス：</strong><%= current_user.email %></p>
      </div>

      <div class="bg-white border border-green-200 rounded-lg shadow-sm p-6 mb-10">
        <h3 class="text-xl font-semibold mb-3 text-green-800">取得したバッジ</h3>
        <%= render 'badge_item' %>
      </div>

      <div class="bg-white border border-green-200 rounded-lg shadow-sm p-6 mb-10">
        <h3 class="text-xl font-semibold mb-3 text-green-800">クイズの履歴</h3>

        <% if @quiz_histories.any? %>
          <canvas id="quizHistoryBarChart"></canvas>

          <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>

          <script>
            const quizHistories = <%= raw(
              @quiz_histories.map do |h|
                {
                  date: h.created_at.strftime("%Y-%m-%d"),
                  correct: h.correct_count,
                  difficulty: h.difficulty || "unknown",
                  genre: h.genre || "不明"
                }
              end.to_json
            ) %>;

            document.addEventListener("turbo:load", function () {
              const ctx = document.getElementById("quizHistoryBarChart");
              if (!ctx || !quizHistories.length) return;

              const labels = quizHistories.map(h => h.date);
              const data = quizHistories.map(h => h.correct);
              const tooltips = quizHistories.map(h => `ジャンル: ${h.genre}\n難易度: ${h.difficulty}`);
              const backgroundColors = quizHistories.map(h => {
                switch (h.difficulty) {
                  case 'easy':
                    return 'rgba(69, 228, 122, 0.6)';
                  case 'hard':
                    return 'rgba(249, 50, 50, 0.6)';
                  default:
                    return 'rgba(150, 150, 150, 0.6)';
                }
              });
              new Chart(ctx, {
                type: 'bar',
                data: {
                  labels: labels,
                  datasets: [
                    {
                      label: 'トータル問題数',
                      data: new Array(labels.length).fill(10),
                      backgroundColor: 'rgba(200, 200, 200, 0.3)',
                      borderWidth: 0,
                      categoryPercentage: 0.6,
                      barPercentage: 1.0,
                      order: 1
                    },
                    {
                      label: '正答数',
                      data: data,
                      backgroundColor: backgroundColors,
                      borderColor: backgroundColors,
                      borderWidth: 1,
                      categoryPercentage: 0.6,
                      barPercentage: 1.0,
                      order: 2
                    }
                  ]
                },
                options: {
                  responsive: true,
                  scales: {
                    x: {
                      stacked: true
                    },
                    y: {
                      beginAtZero: true,
                      max: 10,
                      stepSize: 1,
                      title: {
                        display: true,
                        text: '正答数'
                      }
                    }
                  },
                  plugins: {
                    tooltip: {
                      callbacks: {
                        label: function(context) {
                          const index = context.dataIndex;

                          if (context.dataset.label === 'トータル問題数' && data[index] === 10) {
                            return null;
                          }

                          return [
                            `正答数: ${data[index]}`,
                            tooltips[index]
                          ];
                        }
                      }
                    },
                    title: {
                      display: true,
                      text: '回答履歴（新しい順）'
                    },
                    legend: {
                      display: false
                    }
                  }
                }
              });
            });
          </script>
        <% else %>
          <p>まだクイズの履歴がありません。</p>
        <% end %>
      </div>

      <div class="mt-12 flex flex-col items-center gap-6 max-w-xs mx-auto">
        <%= link_to "クイズを始める", select_quizzes_path, class: "active:scale-95 bg-green-700 text-white px-8 py-4 rounded-lg shadow hover:bg-green-600 transition text-lg font-semibold w-full text-center" %>
        <%= link_to "実例一覧を見る", samples_path, class: "active:scale-95 bg-white border border-green-700 text-green-700 px-8 py-4 rounded-lg shadow hover:bg-green-50 transition text-lg font-semibold w-full text-center" %>
        <% if user_signed_in? %>
          <%= link_to "模擬メールを送る", new_simulation_email_path,
              class: "active:scale-95 bg-green-100 hover:bg-green-200 text-green-800 px-8 py-4 rounded-lg shadow transition text-lg font-semibold w-full text-center" %>
        <% end %>
      </div>
      <div class="mt-12 flex flex-col items-center gap-3 max-w-xs mx-auto">
        <%= link_to "ログアウト", destroy_user_session_path,
            data: { turbo_method: :delete, turbo_confirm: "ログアウトしてもよろしいですか？" },
            class: "active:scale-95 bg-red-100 text-red-800 px-6 py-2 rounded-md shadow hover:bg-red-200 transition text-sm font-medium w-full text-center" %>
      </div>
    </div>
  </section>
</div>