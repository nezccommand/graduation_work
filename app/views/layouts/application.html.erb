<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "フィッシング詐欺学習室" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="フィッシング詐欺学習室" />
    <meta name="twitter:description" content="クイズに挑戦して気軽に詐欺対策をしましょう！" />
    <meta name="twitter:image" content="<%= image_url('ogp.png') %>" />
    <meta property="og:title" content="フィッシング詐欺学習室" />
    <meta property="og:description" content="クイズに挑戦して気軽に詐欺対策をしましょう！" />
    <meta property="og:image" content="<%= image_url('ogp.png') %>" />
    <meta property="og:url" content="<%= root_url %>" />
    <meta property="og:type" content="website" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <%= favicon_link_tag('favicon.ico') %>
    <link rel="apple-touch-icon" href="<%= asset_path 'ロゴ.png' %>">
    <link href="https://fonts.googleapis.com/css2?family=Comic+Neue:wght@400;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-J9NJN7Y3NJ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }

      function trackPageView() {
        gtag('js', new Date());
        gtag('config', 'G-J9NJN7Y3NJ', {
          page_path: window.location.pathname
        });
      }

      document.addEventListener("turbo:load", trackPageView);
    </script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js"></script>
  </head>

  <body class="relative">
    <%= render 'shared/header' %>

    <main class="mt-6 pt-24 px-4">
      <% unless controller_path.start_with?('devise') %>
        <%= render 'shared/flash_message' %>
      <% end %>
      <%= render "shared/loader" %>
      <%= yield %>
    </main>

    <%= render 'shared/footer' %>
  </body>
</html>
